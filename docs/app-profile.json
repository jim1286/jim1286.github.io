  "$id": "hjm.app-profile/portfolio-default-v1",
  "profileVersion": 1,
  "id": "portfolio-default-v1",
  "standardVersion": "1.0.0",
  "status": "active",
  "contractPath": "app.contract.json",
  "schemaPath": "docs/app-contract.schema.json",
  "fieldSemantics": "All fields are normative and hash-pinned by check-standard-assets except human-readable summary and rationale fields, which are informational explanations of the adjacent machine rule.",
  "conformanceStages": {
    "governance-scaffold": "draft governance (any product lifecycle except archived); schema, canonical documents, evidence plans, vendored validators, and CI projection are complete, while runtime implementation gates are not yet claimed. The product may be incubating or active in portfolio.json: lifecycle is product state, not a conformance claim",
    "implementation-conformant": "active governance; all governance checks plus runtime manifests, exact production HJM dependencies, frozen lockfile, canonical HJM Provider theme preference/raw-token guard, verified evidence, and a configured external merge authority pass; unavailable while ci.trustModel.bootstrapStatus is unconfigured",
    "rehearsal": "not a stage: check-app --target-stage implementation-conformant on a draft-governance app runs the active gate, splits findings into actionable vs blockedByPortfolioAuthority, and reports implementationReady; it never sets stage"
  },
  "templateSources": {
    "product": "docs/templates/PRODUCT.md",
    "architecture": "docs/templates/ARCHITECTURE.md",
    "design": "docs/templates/DESIGN.md",
