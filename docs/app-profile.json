  "acceptance": {
    "requiredCategories": [
      "product",
      "architecture",
      "design",
      "i18n",
      "security",
      "quality",
      "release"
    ],
    "passedRequiresEvidence": true,
    "activeRequiresPassedEvidencePerCategory": true,
    "waiversDoNotSatisfyAcceptance": true,
    "verifiedEvidenceRequiresCapturedAt": true,
    "verifiedEvidenceRequiresDigest": true,
    "verifiedEvidenceRequiresNonPlaceholderTypeRecord": true,
    "evidenceLocations": "repository-local records under docs/evidence/: one regular file, or one directory whose index.md is the narrative and whose digest is the sorted sha256 manifest of every file",
    "crossReferencesMustResolve": true,
    "evidenceTrustBoundary": {
      "repositoryDigestProves": "byte-integrity-only",
      "doesNotProve": "factual-authenticity-of-the-observation",
      "activeVerifiedRequires": [
        "subject-head-or-artifact-digest",
        "producer-or-verification-authority",
        "human-approval-or-external-attestation-when-applicable"
      ],
      "repositoryPolicyLiveReverifiedByCentralGate": true
    }
  },
  "waiverPolicy": {
    "allowedRuleLevels": [
      "default"
    ],
    "forbiddenRuleLevels": [
      "required"
    ],
    "approvalRequiredBeforeUse": true,
    "maximumDurationDays": 30,
    "ownerMustDifferFromApprover": true,
    "requiredFields": [
      "ruleId",
      "adrPath",
      "reason",
      "risk",
      "mitigations",
      "owner",
      "approver",
      "createdAt",
      "expiresAt",
      "status"
    ]
  },
  "rules": [
    {
      "id": "APP-IDENTITY-001",
      "level": "required",
      "summary": "앱은 영구 canonical kebab-case ID와 독립 Git 저장소를 사용한다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-RUNTIME-001",
      "level": "required",
      "summary": "새 runtime은 Expo, Next.js 또는 NestJS의 kind-framework 조합만 사용한다.",
      "enforcement": "schema"
    },
    {
      "id": "APP-DOCS-001",
      "level": "required",
      "summary": "PRODUCT, ARCHITECTURE, DESIGN, RELEASE와 decisions 디렉터리를 canonical 위치에 둔다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-TOOLCHAIN-001",
      "level": "required",
      "summary": "pnpm과 Node를 exact version으로 고정하고 canonical scripts를 제공한다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-DESIGN-001",
      "level": "required",
      "summary": "Frontend는 HJM contracts와 runtime renderer를 동일 exact version으로 사용하고, server-only는 근거 있는 not_applicable과 HJM dependency 부재를 강제한다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-I18N-001",
      "level": "required",
      "summary": "첫 사용자 문구부터 공용 catalog와 canonical locale 정책을 사용한다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-EVIDENCE-001",
      "level": "required",
      "summary": "active 앱은 각 필수 acceptance category에 별도 passed criterion과 검증된 evidence를 가지며, ADR이나 waiver는 acceptance를 대체하지 않는다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-RELEASE-001",
      "level": "required",
      "summary": "모바일은 Release Hub를 사용하고 Web/Server-only의 비적용에는 근거를 기록한다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-SERVER-ADAPTER-001",
      "level": "default",
      "summary": "새 NestJS HTTP adapter는 Fastify를 기본으로 선택한다.",
      "enforcement": "review"
    },
    {
      "id": "APP-FRONTEND-TEST-001",
      "level": "default",
      "summary": "새 frontend와 순수 package의 unit/component runner는 Vitest를 기본으로 사용한다.",
      "enforcement": "review"
    },
    {
      "id": "APP-DESIGN-EVIDENCE-001",
      "level": "default",
      "summary": "공용 primitive와 복잡한 상태는 Storybook 또는 동등한 showcase evidence로 검증한다.",
      "enforcement": "review"
    },
    {
      "id": "APP-LIFECYCLE-001",
      "level": "required",
      "summary": "portfolio.json과 app.contract.json의 lifecycle은 같은 검토 변경에서 함께 바뀐다(doctor가 불일치를 차단). lifecycle은 제품 상태이고 conformance 주장은 governance.status가 소유하므로 lifecycle이 release를 막거나 conformance를 부여하지 않는다.",
      "enforcement": "conformance-and-review"
    },
    {
      "id": "APP-REGISTRY-001",
      "level": "required",
      "summary": "루트 .npmrc가 registry와 @hjmds:registry를 npmjs.org로 고정하고 중첩 .npmrc·registry override·Git/URL/path/tarball 의존성을 두지 않는다.",
      "enforcement": "schema-and-conformance"
    },
    {
      "id": "APP-DOCS-002",
      "level": "required",
      "summary": "canonical 문서의 Acceptance/Evidence 표는 contract 투영이며 sync-docs로만 갱신하고, docs/design/은 비규범 작업 문서로 검사 대상이 아니다.",
      "enforcement": "conformance"
    },
    {
      "id": "APP-EVIDENCE-002",
      "level": "required",
      "summary": "evidence record는 regular file 하나 또는 index.md를 가진 디렉터리 하나이며 digest는 digest-evidence 출력과 같아야 한다.",
      "enforcement": "conformance"
    },
    {
      "id": "APP-SECURITY-001",
      "level": "required",
      "summary": "저장소 생성 직후 install-local-git-guards.sh, 첫 release 전과 active 전환 전 audit-sensitive-files.sh를 실행하고 후보가 없어야 한다.",
      "enforcement": "review"
    },
    {
      "id": "APP-QA-001",
      "level": "default",
      "summary": "tools/qa는 생성된 README의 최소 adapter 세트(exploreqa.toml, provider, boot, personas, lanes, run.sh)를 채운다.",
      "enforcement": "review"
    },
    {
      "id": "APP-STATIC-001",
      "level": "required",
      "summary": "전 runtime이 profile toolchain.staticAnalysis의 exact ESLint·typescript-eslint·Prettier·eslint-config-prettier와 runtime preset을 쓰고, canonical .editorconfig·prettier.config.mjs·.prettierignore·eslint.config.mjs·tools/eslint.base.mjs를 byte 그대로 두며 runtime eslint.config.mjs는 base를 import한다.",
      "enforcement": "schema-and-conformance"
    }
  ]
}
